    <Style x:Key="SvgIcon" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill">
        <Setter.Value>
          <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Control}" FallbackValue="#E2E8F0" TargetNullValue="#E2E8F0" />
        </Setter.Value>
      </Setter>
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Background" Value="#161D26" />
      <Setter Property="BorderBrush" Value="#2A3440" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#1C2530" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#3A4654" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#141B24" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.36" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}" />

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="26" />
    </Style>

    <Style x:Key="WindowControlButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#1A2A40" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SidebarButton" TargetType="Button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#1C2530" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#3A4654" />
                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#121820" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarSiteButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="44" />
    </Style>

    <Style x:Key="WideButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#0D1826" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource WideButton}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="#04111C" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="Background" Value="#0B1522" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#3A526F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AddressTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="2,0,8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ClickMode" Value="Press" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="{TemplateBinding Background}">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconChevronDown}" Width="12" Height="12"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                    Fill="{DynamicResource TextMuted}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#16263C" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#16263C" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#1B324F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="Background" Value="#0B1522" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Border"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" />
              <ToggleButton x:Name="ToggleButton"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource ComboBoxToggleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
              <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{DynamicResource TextMain}" />
              <Popup x:Name="Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Grid SnapsToDevicePixels="True"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border Background="{DynamicResource PanelBg}"
                          BorderBrush="{DynamicResource BorderBrushSoft}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Margin="0,4,0,0" />
                  <ScrollViewer Margin="4,6,4,4" VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#3A526F" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box"
                      Width="15"
                      Height="15"
                      CornerRadius="4"
                      Background="#0B1522"
                      BorderBrush="{DynamicResource BorderBrushSoft}"
                      BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="Check"
                      Data="M4,8.4L7.1,11.5L12,4.8"
                      Stroke="#04111C"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Margin="2"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBorder"
                    CornerRadius="8"
                    Background="{DynamicResource Accent}"
                    BorderBrush="#D8F3FF"
                    BorderThickness="1">
              <Border.Effect>
                <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.32" />
              </Border.Effect>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbBorder" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                  </Setter.Value>
                </Setter>
                <Setter TargetName="ThumbBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkSlider" TargetType="Slider">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="#172638" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="{TemplateBinding Height}">
              <Border Height="4"
                      CornerRadius="2"
                      Background="#223249"
                      VerticalAlignment="Center" />
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SliderThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource DarkSlider}" />

    <Style x:Key="ScrollRepeatButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBorder"
                    Background="#33445B"
                    CornerRadius="6"
                    Margin="2" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbBorder" Property="Background" Value="#4A6380" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#2A3A52" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="{x:Static ScrollBar.PageLeftCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="{x:Static ScrollBar.PageRightCommand}" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PanelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="11"
                           Margin="18,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#16263C" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavPill" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}"
                    BorderBrush="Transparent"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#16243A" />
                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="#04111C" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="OuterBorder"
          Background="{DynamicResource ChromeBg}"
          BorderBrush="{DynamicResource BorderBrushSoft}"
          BorderThickness="1"
          CornerRadius="14"
          ClipToBounds="True"
          SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="58" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PanelColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource SidebarBg}"
              BorderBrush="{DynamicResource BorderBrushSoft}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="7,10,7,12" LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" x:Name="SidebarNavStrip">
            <Border Height="1"
                    Background="{DynamicResource BorderBrushSoft}"
                    Opacity="0.55"
                    Margin="4,0,4,8" />
            <Button Style="{StaticResource SidebarButton}" ToolTip="History (Ctrl+Shift+H)" Click="HistoryPanelButton_Click">
              <Border Width="36" Height="36" CornerRadius="11" Background="#141B24" BorderBrush="#2A3440" BorderThickness="1">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconHistory}" Width="17" Height="17" Fill="{DynamicResource TextMain}" />
              </Border>
            </Button>
            <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Opacity="0.4" Margin="10,5,10,5" />
            <Button Style="{StaticResource SidebarButton}" ToolTip="Downloads (Ctrl+Shift+J)" Click="DownloadsButton_Click">
              <Border Width="36" Height="36" CornerRadius="11" Background="#141B24" BorderBrush="#2A3440" BorderThickness="1">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconDownload}" Width="17" Height="17" Fill="{DynamicResource TextMain}" />
              </Border>
            </Button>
            <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Opacity="0.4" Margin="10,5,10,5" />
            <Button Style="{StaticResource SidebarButton}" ToolTip="Bookmarks (Ctrl+Shift+O)" Click="BookmarksPanelButton_Click">
              <Border Width="36" Height="36" CornerRadius="11" Background="#141B24" BorderBrush="#2A3440" BorderThickness="1">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconBookmarks}" Width="17" Height="17" Fill="{DynamicResource TextMain}" />
              </Border>
            </Button>
            <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Opacity="0.4" Margin="10,5,10,5" />
            <Button Style="{StaticResource SidebarButton}" ToolTip="Settings" Click="SettingsButton_Click">
              <Border Width="36" Height="36" CornerRadius="11" Background="#141B24" BorderBrush="#2A3440" BorderThickness="1">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconSettings}" Width="17" Height="17" Fill="{DynamicResource TextMain}" />
              </Border>
            </Button>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalAlignment="Stretch"
                        Margin="0,0,0,6">
            <StackPanel x:Name="SidebarShortcuts" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" x:Name="MainContentGrid">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="TitleBarRow" Height="Auto" />
          <RowDefinition x:Name="TabRow" Height="Auto" />
          <RowDefinition x:Name="ToolbarRow" Height="Auto" />
          <RowDefinition x:Name="BookmarksRow" Height="Auto" />
          <RowDefinition x:Name="FindRow" Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
        <Grid x:Name="TitleBarDrag"
              Height="34"
              Background="Transparent"
              MouseLeftButtonDown="TitleBarDrag_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconSparkle}" Width="16" Height="16" Fill="{DynamicResource Accent}" />
            <TextBlock x:Name="WindowTitleText" Text="Stella Orion" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
            <Border x:Name="ShieldBadge"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="8,3"
                    Background="#141B24"
                    Cursor="Hand"
                    MouseLeftButtonUp="ShieldBadge_MouseLeftButtonUp">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentAlt}" VerticalAlignment="Center" />
                <TextBlock x:Name="ShieldStatus" Text="Shield On" Margin="5,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="10" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Button Grid.Column="2" x:Name="MenuButton" Style="{StaticResource WindowControlButton}" Width="40" ToolTip="Menu" Click="MenuButton_Click">
            <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconMoreVertical}" Width="15" Height="15" />
          </Button>

          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button Style="{StaticResource WindowControlButton}" ToolTip="Minimize" Click="MinimizeButton_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconMinimize}" Width="14" Height="14" />
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" ToolTip="Maximize" Click="MaximizeButton_Click">
              <Path x:Name="MaximizeIcon" Style="{StaticResource SvgIcon}" Data="{StaticResource IconMaximize}" Width="14" Height="14" />
            </Button>
            <Button Style="{StaticResource WindowCloseButton}" ToolTip="Close" Click="WindowCloseButton_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconClose}" Width="14" Height="14" />
            </Button>
          </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource ChromeBg}"
                Padding="12,4,12,0"
                MouseLeftButtonDown="ChromeDrag_MouseLeftButtonDown">
          <ScrollViewer x:Name="TabScroller"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PanningMode="HorizontalOnly">
            <StackPanel Orientation="Horizontal">
              <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
              <Button x:Name="NewTabButton" Style="{StaticResource IconButton}" Width="30" Height="28" ToolTip="New tab (Ctrl+T)" Click="NewTabButton_Click">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPlus}" Width="15" Height="15" />
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="12,7,12,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="BackButton" Style="{StaticResource IconButton}" ToolTip="Back (Alt+Left)" Click="BackButton_Click" Margin="0,0,4,0">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconBack}" Width="17" Height="17" />
              </Button>
              <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" ToolTip="Forward (Alt+Right)" Click="ForwardButton_Click" Margin="0,0,4,0">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconForward}" Width="17" Height="17" />
              </Button>
              <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" ToolTip="Reload (F5)" Click="ReloadButton_Click" Margin="0,0,4,0">
                <Path x:Name="ReloadIcon" Style="{StaticResource SvgIcon}" Data="{StaticResource IconReload}" Width="17" Height="17" />
              </Button>
              <Button x:Name="HomeButton" Style="{StaticResource IconButton}" ToolTip="Home" Click="HomeButton_Click">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconHome}" Width="17" Height="17" />
              </Button>
            </StackPanel>

            <Border x:Name="AddressChrome"
                    Grid.Column="1"
                    CornerRadius="16"
                    BorderBrush="#2A3440"
                    BorderThickness="1"
                    Background="#141B24"
                    Margin="10,0"
                    Height="36">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SecurityBadge"
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        CornerRadius="6"
                        Background="#10161E"
                        Margin="10,0,4,0"
                        VerticalAlignment="Center"
                        ToolTip="Search or internal page"
                        MouseLeftButtonUp="SecurityBadge_MouseLeftButtonUp"
                        Cursor="Hand">
                  <Path x:Name="SecurityIcon"
                        Style="{StaticResource SvgIcon}"
                        Data="{StaticResource IconGlobe}"
                        Width="12"
                        Height="12"
                        Fill="{DynamicResource TextMuted}" />
                </Border>

                <TextBox x:Name="AddressBox"
                         Grid.Column="1"
                         Style="{StaticResource AddressTextBox}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         ToolTip="Search or enter address"
                         KeyDown="AddressBox_KeyDown"
                         GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                         LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                         TextChanged="AddressBox_TextChanged">
                  <TextBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Cut" Command="ApplicationCommands.Cut" />
                      <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                      <MenuItem Header="Paste" Command="ApplicationCommands.Paste" />
                      <Separator />
                      <MenuItem Header="Paste and go" Click="PasteAndGo_Click" />
                      <MenuItem Header="Copy URL" Click="CopyUrl_Click" />
                      <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" />
                    </ContextMenu>
                  </TextBox.ContextMenu>
                </TextBox>

                <TextBlock Grid.Column="2"
                           x:Name="ZoomIndicator"
                           Text="100%"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Visibility="Collapsed"
                           Cursor="Hand"
                           MouseLeftButtonUp="ZoomIndicator_MouseLeftButtonUp" />

                <Button Grid.Column="3"
                        x:Name="StarButton"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,4,0"
                        ToolTip="Bookmark this page (Ctrl+D)"
                        Click="StarButton_Click">
                  <Path x:Name="StarIcon" Style="{StaticResource SvgIcon}" Data="{StaticResource IconStarOutline}" Width="16" Height="16" Fill="{DynamicResource TextMuted}" />
                </Button>
              </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="PrivateTabButton" Style="{StaticResource IconButton}" ToolTip="New private tab (Ctrl+Shift+N)" Click="PrivateTabButton_Click" Margin="0,0,4,0">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPrivate}" Width="16" Height="16" />
              </Button>
              <StackPanel x:Name="ExtensionActionStrip" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0" />
              <Button x:Name="ExtensionsButton" Style="{StaticResource IconButton}" ToolTip="Extensions" Click="ExtensionsButton_Click" Margin="0,0,4,0">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconExtensions}" Width="16" Height="16" />
              </Button>
              <Button x:Name="DevToolsButton" Style="{StaticResource IconButton}" ToolTip="Developer tools (F12)" Click="DevToolsButton_Click" Margin="0,0,4,0">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconCode}" Width="17" Height="17" />
              </Button>
              <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Settings" Click="SettingsButton_Click">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconSettings}" Width="17" Height="17" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="BookmarksBar"
                Grid.Row="3"
                Background="{DynamicResource ChromeBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="10,4,10,4"
                Visibility="Collapsed">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
            <StackPanel x:Name="BookmarksBarStrip" Orientation="Horizontal" />
          </ScrollViewer>
        </Border>

        <Border x:Name="FindBar"
                Grid.Row="4"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox"
                     Grid.Column="0"
                     KeyDown="FindBox_KeyDown"
                     TextChanged="FindBox_TextChanged" />
            <TextBlock x:Name="FindStatus" Grid.Column="1" Text="" Foreground="{DynamicResource TextMuted}" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="12" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" ToolTip="Previous (Shift+Enter)" Click="FindPrev_Click" Margin="0,0,4,0">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconChevronUp}" Width="13" Height="13" />
            </Button>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" ToolTip="Next (Enter)" Click="FindNext_Click" Margin="0,0,4,0">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconChevronDown}" Width="13" Height="13" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="30" ToolTip="Close (Esc)" Click="FindClose_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconClose}" Width="13" Height="13" />
            </Button>
          </Grid>
        </Border>

        <Grid x:Name="WebHost" Grid.Row="5" Background="{DynamicResource ChromeBg}" />
      </Grid>

      <Border x:Name="SidePanel"
              Grid.Column="2"
              Background="{DynamicResource PanelBg}"
              BorderBrush="{DynamicResource BorderBrushSoft}"
              BorderThickness="1,0,0,0"
              CornerRadius="14,0,0,0"
              Visibility="Collapsed">
        <DockPanel Margin="16">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Control Center" Foreground="{DynamicResource TextMuted}" FontSize="11" />
              <TextBlock x:Name="PanelTitle" Text="Privacy" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Close (Esc)" Click="ClosePanelButton_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconClose}" Width="13" Height="13" />
            </Button>
          </Grid>

          <UniformGrid x:Name="PanelNav" DockPanel.Dock="Top" Columns="7" Rows="1" Margin="0,0,0,16" Height="38">
            <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavPill}" Tag="Privacy" ToolTip="Privacy" Click="PanelNav_Click" IsChecked="True">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconShield}" Width="16" Height="16" />
            </RadioButton>
            <RadioButton x:Name="NavAppearance" Style="{StaticResource NavPill}" Tag="Appearance" ToolTip="Appearance" Click="PanelNav_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconSparkle}" Width="16" Height="16" />
            </RadioButton>
            <RadioButton x:Name="NavSearch" Style="{StaticResource NavPill}" Tag="Search" ToolTip="Search &amp; Home" Click="PanelNav_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconSearch}" Width="16" Height="16" />
            </RadioButton>
            <RadioButton x:Name="NavExtensions" Style="{StaticResource NavPill}" Tag="Extensions" ToolTip="Extensions" Click="PanelNav_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconExtensions}" Width="16" Height="16" />
            </RadioButton>
            <RadioButton x:Name="NavBookmarks" Style="{StaticResource NavPill}" Tag="Bookmarks" ToolTip="Bookmarks" Click="PanelNav_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconBookmarks}" Width="16" Height="16" />
            </RadioButton>
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavPill}" Tag="History" ToolTip="History" Click="PanelNav_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconHistory}" Width="16" Height="16" />
            </RadioButton>
            <RadioButton x:Name="NavDownloads" Style="{StaticResource NavPill}" Tag="Downloads" ToolTip="Downloads" Click="PanelNav_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconDownload}" Width="16" Height="16" />
            </RadioButton>
          </UniformGrid>

          <Grid x:Name="PanelContent">
            <ScrollViewer x:Name="PanePrivacy" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <CheckBox x:Name="BlockTrackersCheck" Content="Tracker &amp; ad blocker" Checked="PrivacySettingChanged" Unchecked="PrivacySettingChanged" />
                <CheckBox x:Name="DoNotTrackCheck" Content="Do Not Track + Sec-GPC headers" Checked="PrivacySettingChanged" Unchecked="PrivacySettingChanged" />
                <CheckBox x:Name="HardenPermissionsCheck" Content="Auto-deny camera, mic, geolocation" Checked="PrivacySettingChanged" Unchecked="PrivacySettingChanged" />
                <CheckBox x:Name="HttpsFirstCheck" Content="HTTPS first" Checked="PrivacySettingChanged" Unchecked="PrivacySettingChanged" />
                <TextBlock x:Name="BlockCountLabel" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,6,0,12" />
                <Button x:Name="ClearDataButton" Style="{StaticResource WideButton}" Click="ClearDataButton_Click" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconBackspace}" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="Clear Browsing Data" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource WideButton}" Click="ClearHistoryButton_Click" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconHistory}" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="Clear History" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PaneAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="LblTheme" Text="Theme" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <ComboBox x:Name="ThemeBox" Margin="0,0,0,14" SelectionChanged="ThemeBox_SelectionChanged">
                  <ComboBoxItem Content="Midnight" />
                  <ComboBoxItem Content="Aurora" />
                  <ComboBoxItem Content="Graphite" />
                  <ComboBoxItem Content="Nord" />
                  <ComboBoxItem Content="Daylight" />
                </ComboBox>
                <TextBlock x:Name="LblUiFont" Text="Interface font" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <ComboBox x:Name="UiFontBox" Margin="0,0,0,14" SelectionChanged="UiFontBox_SelectionChanged" />
                <TextBlock x:Name="LblLanguage" Text="Language" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <ComboBox x:Name="LanguageBox" Margin="0,0,0,14" SelectionChanged="LanguageBox_SelectionChanged" />
                <CheckBox x:Name="ForceDarkPagesCheck" Content="Force dark websites" Checked="AppearanceSettingChanged" Unchecked="AppearanceSettingChanged" />
                <CheckBox x:Name="BookmarksBarCheck" Content="Show bookmarks bar" Checked="AppearanceSettingChanged" Unchecked="AppearanceSettingChanged" />
                <CheckBox x:Name="RestoreSessionCheck" Content="Restore tabs on startup" Checked="AppearanceSettingChanged" Unchecked="AppearanceSettingChanged" />
                <TextBlock x:Name="LblAccent" Text="Accent" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,8" />
                <UniformGrid Columns="6" Rows="1" Margin="0,0,0,8">
                  <Button Style="{StaticResource IconButton}" Background="#38BDF8" Tag="#38BDF8" ToolTip="Sky" Click="AccentButton_Click" Margin="0,0,5,0" />
                  <Button Style="{StaticResource IconButton}" Background="#22C55E" Tag="#22C55E" ToolTip="Green" Click="AccentButton_Click" Margin="0,0,5,0" />
                  <Button Style="{StaticResource IconButton}" Background="#A78BFA" Tag="#A78BFA" ToolTip="Violet" Click="AccentButton_Click" Margin="0,0,5,0" />
                  <Button Style="{StaticResource IconButton}" Background="#F97316" Tag="#F97316" ToolTip="Orange" Click="AccentButton_Click" Margin="0,0,5,0" />
                  <Button Style="{StaticResource IconButton}" Background="#F43F5E" Tag="#F43F5E" ToolTip="Rose" Click="AccentButton_Click" Margin="0,0,5,0" />
                  <Button Style="{StaticResource IconButton}" Background="#FBBF24" Tag="#FBBF24" ToolTip="Amber" Click="AccentButton_Click" />
                </UniformGrid>
                <Button x:Name="CustomAccentButton" Style="{StaticResource WideButton}" Click="CustomAccentButton_Click" Margin="0,4,0,14">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AccentPreview" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}" Margin="0,0,8,0" />
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPalette}" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock x:Name="LblCustomAccent" Text="Custom color" />
                  </StackPanel>
                </Button>
                <TextBlock x:Name="LblBackgroundMedia" Text="New tab background" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="BackgroundMediaBox" IsReadOnly="True" />
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Width="36" Height="34" ToolTip="Choose background media" Click="ChooseBackgroundMedia_Click">
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconMedia}" Width="16" Height="16" />
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="6,0,0,0" Width="36" Height="34" ToolTip="Clear background media" Click="ClearBackgroundMedia_Click">
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconClose}" Width="13" Height="13" />
                  </Button>
                </Grid>
                <TextBlock Text="PNG, JPG, GIF, MP4, WebM" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,8" />
                <TextBlock Text="Wallpaper visibility" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,4" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="BackgroundOpacitySlider" Minimum="15" Maximum="100" TickFrequency="1" ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                  <TextBlock x:Name="BackgroundOpacityLabel" Grid.Column="1" Text="55%" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="Wallpaper blur" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,4" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="BackgroundBlurSlider" Minimum="0" Maximum="24" TickFrequency="1" ValueChanged="BackgroundBlurSlider_ValueChanged" />
                  <TextBlock x:Name="BackgroundBlurLabel" Grid.Column="1" Text="0px" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Opacity="0.5" Margin="0,4,0,14" />
                <TextBlock x:Name="LblUpdates" Text="Updates" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <TextBlock x:Name="AppVersionLabel" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,8" />
                <Button x:Name="CheckUpdatesButton" Style="{StaticResource WideButton}" Click="CheckUpdatesButton_Click" Margin="0,0,0,14" />
                <CheckBox x:Name="SoftEffectsCheck" Content="Soft glass effects" Checked="AppearanceSettingChanged" Unchecked="AppearanceSettingChanged" />
                <CheckBox x:Name="BackgroundMusicEnabledCheck" Content="Play music on new tab" Checked="AppearanceSettingChanged" Unchecked="AppearanceSettingChanged" />
                <TextBlock x:Name="LblBackgroundMusic" Text="New tab music" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,6" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="BackgroundMusicBox" IsReadOnly="True" />
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Width="36" Height="34" ToolTip="Choose background music" Click="ChooseBackgroundMusic_Click">
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconMusic}" Width="16" Height="16" />
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="6,0,0,0" Width="36" Height="34" ToolTip="Clear background music" Click="ClearBackgroundMusic_Click">
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconClose}" Width="13" Height="13" />
                  </Button>
                </Grid>
                <TextBlock Text="MP3, WAV, OGG, M4A, FLAC" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="MusicVolumeSlider" Minimum="2" Maximum="100" TickFrequency="1" ValueChanged="MusicVolumeSlider_ValueChanged" />
                  <TextBlock x:Name="MusicVolumeLabel" Grid.Column="1" Text="28%" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PaneSearch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Default search engine" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <ComboBox x:Name="SearchEngineBox" Margin="0,0,0,14" SelectionChanged="SearchEngineBox_SelectionChanged">
                  <ComboBoxItem Content="DuckDuckGo" />
                  <ComboBoxItem Content="Google" />
                  <ComboBoxItem Content="Bing" />
                  <ComboBoxItem Content="Brave" />
                  <ComboBoxItem Content="Startpage" />
                  <ComboBoxItem Content="Yandex" />
                </ComboBox>
                <TextBlock Text="Home page" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <TextBox x:Name="HomePageBox" Margin="0,0,0,14" LostFocus="HomePageBox_LostFocus" />
                <TextBlock Text="Download folder" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="DownloadFolderBox" IsReadOnly="True" />
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Width="36" Height="34" ToolTip="Choose folder" Click="ChooseDownloadFolder_Click">
                    <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconFolder}" Width="16" Height="16" />
                  </Button>
                </Grid>
                <CheckBox x:Name="AskWhereDownloadCheck" Content="Always ask where to save" Checked="AppearanceSettingChanged" Unchecked="AppearanceSettingChanged" />
              </StackPanel>
            </ScrollViewer>

            <DockPanel x:Name="PaneExtensions" Visibility="Collapsed">
              <Button DockPanel.Dock="Top" x:Name="AddExtensionButton" Style="{StaticResource WideButton}" Click="AddExtensionButton_Click" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPlus}" Width="14" Height="14" Margin="0,0,8,0" />
                  <TextBlock Text="Add Unpacked Extension" />
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Top" x:Name="InstallChromeStoreButton" Style="{StaticResource WideButton}" Click="InstallChromeStoreButton_Click" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconDownload}" Width="14" Height="14" Margin="0,0,8,0" />
                  <TextBlock Text="Install from Current Chrome Web Store Page" />
                </StackPanel>
              </Button>
              <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                Chrome Web Store install buttons are handled through Stella Orion's extension installer when WebView2 cannot install them directly.
              </TextBlock>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ExtensionList" />
              </ScrollViewer>
            </DockPanel>

            <DockPanel x:Name="PaneBookmarks" Visibility="Collapsed">
              <TextBox DockPanel.Dock="Top" x:Name="BookmarkSearchBox" Margin="0,0,0,12" TextChanged="BookmarkSearchBox_TextChanged" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="BookmarkPanelList" />
              </ScrollViewer>
            </DockPanel>

            <DockPanel x:Name="PaneHistory" Visibility="Collapsed">
              <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HistorySearchBox" TextChanged="HistorySearchBox_TextChanged" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Width="36" Height="34" ToolTip="Clear history" Click="ClearHistoryButton_Click">
                  <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconBackspace}" Width="16" Height="16" />
                </Button>
              </Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HistoryPanelList" />
              </ScrollViewer>
            </DockPanel>

            <ScrollViewer x:Name="PaneDownloads" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel x:Name="DownloadsList" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <Border x:Name="ExtensionActionCard"
              Grid.Column="1"
              Width="320"
              Height="80"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,112,18,0"
              Visibility="Collapsed"
              Panel.ZIndex="30"
              Background="{DynamicResource PanelBg}"
              BorderBrush="{DynamicResource BorderBrushSoft}"
              BorderThickness="1"
              CornerRadius="16"
              ClipToBounds="True"
              SnapsToDevicePixels="True">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.2" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border x:Name="ExtensionPopupDragBar"
                  Grid.Row="0"
                  Height="28"
                  Background="Transparent"
                  Cursor="SizeAll"
                  Visibility="Collapsed"
                  MouseLeftButtonDown="ExtensionPopupDragBar_MouseLeftButtonDown"
                  MouseMove="ExtensionPopupDragBar_MouseMove"
                  MouseLeftButtonUp="ExtensionPopupDragBar_MouseLeftButtonUp">
            <Border Width="40"
                    Height="4"
                    CornerRadius="2"
                    Background="#3A4654"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
          </Border>
          <Grid x:Name="ExtensionPopupHeader" Grid.Row="1" Margin="12,10,10,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ExtensionPopupIcon" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface}" Margin="0,0,8,0" />
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="ExtensionPopupTitle" Text="Extension" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ExtensionPopupSubtitle" Text="chrome-extension" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="28" Height="26" ToolTip="Close" Click="CloseExtensionAction_Click">
              <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconClose}" Width="12" Height="12" />
            </Button>
          </Grid>
          <Grid x:Name="ExtensionActionHost"
                Grid.Row="2"
                Margin="0"
                HorizontalAlignment="Left"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <StackPanel x:Name="ExtensionFallbackPanel" Visibility="Collapsed" Margin="12,0,12,12" Panel.ZIndex="1" />
            <Border x:Name="ExtensionPopupLoading"
                    Panel.ZIndex="2"
                    Background="{DynamicResource PanelBg}"
                    Visibility="Collapsed">
              <TextBlock Text="Loading extension…"
                         Foreground="{DynamicResource TextMuted}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="12" />
            </Border>
          </Grid>
          <Button x:Name="ExtensionPopupCloseOverlay"
                  Grid.RowSpan="3"
                  Style="{StaticResource GhostButton}"
                  Width="28"
                  Height="26"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="8,8,8,0"
                  Panel.ZIndex="4"
                  Visibility="Collapsed"
                  ToolTip="Close"
                  Click="CloseExtensionAction_Click">
            <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconClose}" Width="11" Height="11" />
          </Button>
        </Grid>
      </Border>

      <StackPanel x:Name="ToastHost"
                  Grid.Column="1"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Margin="0,0,18,18" />

      <Popup x:Name="MenuPopup"
             PlacementTarget="{Binding ElementName=MenuButton}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade">
        <Border Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6"
                MinWidth="240">
          <StackPanel>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuNewTab_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPlus}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="New tab" />
                <TextBlock Text="Ctrl+T" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="20,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuPrivateTab_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPrivate}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="Private tab" />
                <TextBlock Text="Ctrl+Shift+N" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="20,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuFind_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="Find on page" />
                <TextBlock Text="Ctrl+F" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="20,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuPrint_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPrint}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="Print" />
                <TextBlock Text="Ctrl+P" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="20,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuFullscreen_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconFullscreen}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="Toggle fullscreen" />
                <TextBlock Text="F11" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="20,0,0,0" />
              </StackPanel>
            </Button>
            <Border Background="{DynamicResource BorderBrushSoft}" Height="1" Margin="6,4" />
            <Grid Margin="6,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Zoom" VerticalAlignment="Center" />
              <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="MenuZoomOut_Click" Width="28" Height="28">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconMinimize}" Width="13" Height="13" />
              </Button>
              <TextBlock Grid.Column="2" x:Name="MenuZoomLabel" Text="100%" VerticalAlignment="Center" Width="48" TextAlignment="Center" />
              <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="MenuZoomIn_Click" Width="28" Height="28">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconPlus}" Width="13" Height="13" />
              </Button>
            </Grid>
            <Border Background="{DynamicResource BorderBrushSoft}" Height="1" Margin="6,4" />
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuBookmarks_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconBookmarks}" Width="15" Height="15" Margin="0,0,10,0" />
                <TextBlock Text="Bookmarks" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuHistory_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconHistory}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="History" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuDownloads_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconDownload}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="Downloads" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource WideButton}" HorizontalContentAlignment="Left" Click="MenuSettings_Click" Background="Transparent" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource SvgIcon}" Data="{StaticResource IconSettings}" Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Popup>

      <Popup x:Name="SuggestionPopup"
             PlacementTarget="{Binding ElementName=AddressChrome}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="None"
             VerticalOffset="4">
        <Border Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="4"
                MinWidth="540"
                MaxWidth="800">
          <StackPanel x:Name="SuggestionList" />
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
